    "android:sync": "vite build && npx cap sync android && node scripts/android-permissions.mjs",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite": "^8.3.0"
  }
}
