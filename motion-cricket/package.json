{
  "name": "motion-cricket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-vision.mjs",
    "setup:vision": "node scripts/setup-vision.mjs",
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
    "build": "vite build",
    "preview": "vite preview --host",
